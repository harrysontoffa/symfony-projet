{% extends "base.html.twig" %}
{% block body %}
{{ form_start(categoryForm, {'attr': {'class': 'w-full max-w-md rounded-2xl border border-stone-800 bg-stone-900
p-10'} }) }}

<div class="mb-3">
    {{ form_label(categoryForm.name, 'Nom de la Category', {'label_attr':{'class':'mb-2 block text-sm font-medium
    text-stone-300'} }) }}
    {{ form_widget(categoryForm.name, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700
    bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4
    focus:ring-amber-400/20'} } ) }}
    <div>
        {{ form_errors(categoryForm.name) }}
    </div>

        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-amber-400 px-5 py-3 font-semibold text-stone-950 transition-colors hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">Enregister</button>


    {{ form_end(categoryForm) }}
    {% endblock body %}
