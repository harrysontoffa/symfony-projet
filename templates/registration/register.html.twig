{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24">
    <div class="flex flex-wrap items-center justify-between gap-16">
    <div class="max-w-xl">
    <h1 class="font-['Fraunces',serif] text-5xl leading-[1.05] font-medium tracking-tight text-stone-100 md:text-6xl">Ouvrez votre <em class="italic text-amber-400">carte</em> de lecteur.</h1>

    {{ form_errors(registrationForm) }}
    </div>

    {{ form_start(registrationForm, {'attr': {'class': 'w-full max-w-md rounded-2xl border border-stone-800 bg-stone-900 p-10'} }) }}
    <div class="mb-3">
        {{ form_label(registrationForm.lastname, 'Votre nom', {'label_attr':{'class':'mb-2 block text-sm font-medium text-stone-300'} }) }}
        {{ form_widget(registrationForm.lastname, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700 bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4 focus:ring-amber-400/20'} } ) }}
        <div>
            {{ form_errors(registrationForm.lastname) }}
        </div>

    </div>
    <div class="mb-3">
        {{ form_label(registrationForm.firstname, 'Votre prenom', {'label_attr':{'class':'mb-2 block text-sm font-medium text-stone-300'} }) }}
        {{ form_widget(registrationForm.firstname, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700 bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4 focus:ring-amber-400/20'} } ) }}
        <div>
            {{ form_errors(registrationForm.firstname) }}
        </div>

    </div>
    <div class="mb-3">
        {{ form_label(registrationForm.age, 'Votre age', {'label_attr':{'class':'mb-2 block text-sm font-medium text-stone-300'} }) }}
        {{ form_widget(registrationForm.age, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700 bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4 focus:ring-amber-400/20'} } ) }}
        <div>
            {{ form_errors(registrationForm.age) }}
        </div>

    </div>
    <div class="mb-3">
        {{ form_label(registrationForm.email, 'Votre mail', {'label_attr':{'class':'mb-2 block text-sm font-medium text-stone-300'} }) }}
        {{ form_widget(registrationForm.email, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700 bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4 focus:ring-amber-400/20'} } ) }}
        <div>
            {{ form_errors(registrationForm.email) }}
        </div>

    </div>


        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'mb-2 block text-sm font-medium text-stone-300'} }) }}
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'h-12 w-full rounded-[10px] border border-stone-700 bg-stone-950 px-4 text-stone-100 placeholder:text-stone-500 focus:border-amber-400 focus:outline-none focus:ring-4 focus:ring-amber-400/20'} } ) }}
            <div class="text-sm text-red-300">
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-3">
            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-[18px] w-[18px] accent-amber-400'} }) }}
            {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'text-sm font-medium text-stone-300'} }) }}
            <div class="w-full text-sm text-red-300">
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>
        </div>

        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-amber-400 px-5 py-3 font-semibold text-stone-950 transition-colors hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">Register</button>
    {{ form_end(registrationForm) }}
    </div>
</section>
{% endblock %}
