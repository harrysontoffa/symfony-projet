{% extends "base.html.twig" %}

{% block title %}Calculatrice{% endblock %}

{% block body %}
<section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24">
    <div class="mb-12 border-b border-stone-800 pb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-400">Calculatrice</p>
        <h1 class="mt-5 font-['Fraunces',serif] text-5xl leading-[1.05] font-medium tracking-tight md:text-6xl">Résultat du <em class="italic text-amber-400">calcul</em></h1>
    </div>

    <div class="flex max-w-xl flex-col gap-8 rounded-2xl border border-stone-800 bg-stone-900 p-10">
        <div class="grid h-12 w-12 place-items-center rounded-xl border border-stone-700 text-amber-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h4"/></svg>
        </div>
        <p class="flex flex-wrap items-baseline gap-x-4 gap-y-2 font-['Fraunces',serif] text-4xl font-medium tracking-tight text-stone-300">
            <span>{{ nbr1 }}</span>
            <span class="text-stone-400">{{ signeOperateur }}</span>
            <span>{{ nbr2 }}</span>
            <span class="text-stone-400">=</span>
        </p>
        <div class="border-t border-stone-800 pt-8">
            <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-400">Résultat</h2>
            <p class="mt-2 break-all font-['Fraunces',serif] text-6xl font-medium tracking-tight text-amber-400">{{ results }}</p>
        </div>
    </div>
</section>
{% endblock body %}
