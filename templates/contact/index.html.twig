{% extends "base.html.twig" %}

{% block title %}Contact{% endblock %}

{% block body %}
<section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24">
    <div class="mb-12 border-b border-stone-800 pb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-400">Contact</p>
        <h1 class="mt-5 font-['Fraunces',serif] text-5xl leading-[1.05] font-medium tracking-tight capitalize md:text-6xl">{{ name }}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-400">Les coordonnées de ce contact.</p>
    </div>

    <div class="flex max-w-md flex-col gap-6 rounded-2xl border border-stone-800 bg-stone-900 p-10">
        <dl class="flex flex-col gap-6">
            <div class="flex items-center gap-4">
                <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-stone-700 text-amber-400">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                </div>
                <div class="min-w-0">
                    <dt class="text-sm font-medium text-stone-300">Email</dt>
                    <dd class="truncate text-stone-100">{{ mail }}</dd>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-stone-700 text-amber-400">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>
                </div>
                <div class="min-w-0">
                    <dt class="text-sm font-medium text-stone-300">Téléphone</dt>
                    <dd class="truncate text-stone-100">{{ numero }}</dd>
                </div>
            </div>
        </dl>
        <a href="mailto:{{ mail }}" class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-amber-400 px-5 py-3 font-semibold text-stone-950 transition-colors hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">Envoyer un email</a>
    </div>
</section>
{% endblock body %}
