<span data-variant="{{ variant }}" class="inline-flex w-fit items-center gap-2 rounded-full border border-stone-700 bg-stone-900 px-3 py-1 text-xs font-semibold tracking-wide text-stone-300 data-[variant=primary]:border-amber-800 data-[variant=primary]:bg-amber-950 data-[variant=primary]:text-amber-300 data-[variant=success]:border-emerald-800 data-[variant=success]:bg-emerald-950 data-[variant=success]:text-emerald-300 data-[variant=warning]:border-amber-700 data-[variant=warning]:bg-amber-950 data-[variant=warning]:text-amber-200 data-[variant=danger]:border-red-900 data-[variant=danger]:bg-red-950 data-[variant=danger]:text-red-300">
    {{ label }}
    <span class="border-l border-current/30 pl-2 font-medium tabular-nums">{{ year }}</span>
</span>
