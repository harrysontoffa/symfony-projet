{% props title, description, date, id, author = 'Anonyme' %}
{% set covers = ['bg-red-900', 'bg-sky-900', 'bg-emerald-900', 'bg-amber-800', 'bg-teal-900', 'bg-stone-700'] %}
<article class="flex flex-wrap items-start gap-12 md:gap-16">
    <div aria-hidden="true" class="{{ covers[id % covers|length] }} flex aspect-[2/3] w-full max-w-[280px] flex-col justify-between rounded-l-[4px] rounded-r-[10px] p-7">
        <span class="font-['Fraunces',serif] text-2xl leading-tight font-medium tracking-tight text-stone-100">{{ title }}</span>
        <span class="text-xs uppercase tracking-widest text-stone-200">{{ author }}</span>
    </div>

    <div class="min-w-0 flex-1 basis-80">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-400">Livre n°{{ id }}</p>
        <h1 class="mt-5 font-['Fraunces',serif] text-5xl leading-[1.05] font-medium tracking-tight md:text-6xl">{{ title }}</h1>

        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
            <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                <dt class="sr-only">Auteur</dt>
                <dd class="text-stone-300">{{ author }}</dd>
            </div>
            <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <dt class="sr-only">Date de publication</dt>
                <dd class="text-stone-300">{{ date }}</dd>
            </div>
        </dl>

        <div class="mt-10 border-t border-stone-800 pt-10">
            <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-400">Résumé</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-300">{{ description }}</p>
        </div>

        <a href="{{ path('app_books') }}" class="mt-10 inline-flex items-center gap-2 rounded-[10px] border border-stone-700 px-5 py-3 font-semibold text-stone-100 transition-colors hover:border-stone-500 hover:bg-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            Retour au catalogue
        </a>
    </div>
</article>
