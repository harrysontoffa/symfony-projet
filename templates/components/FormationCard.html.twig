{% props title, description %}
<article {{ attributes.defaults({
    class: 'flex flex-col rounded-2xl border border-stone-800 bg-stone-900 p-8 transition duration-200 hover:-translate-y-1 hover:border-stone-600',
}) }}>
    <div class="grid h-12 w-12 place-items-center rounded-xl border border-stone-700 text-amber-400">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10 12 5 2 10l10 5 10-5Z"/>
            <path d="M6 12v5c3 2 9 2 12 0v-5"/>
            <path d="M22 10v6"/>
        </svg>
    </div>

    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-stone-400">Formation</p>
    <h3 class="mt-2 font-['Fraunces',serif] text-2xl font-medium tracking-tight text-stone-100">{{ title }}</h3>
    <p class="mt-3 flex-1 leading-relaxed text-stone-400">{{ description }}</p>
</article>
