{% props message, type = 'info' %}
{% set styles = {
    info:    'border-stone-700 bg-stone-900 text-stone-200',
    success: 'border-emerald-800 bg-emerald-950 text-emerald-200',
    warning: 'border-amber-800 bg-amber-950 text-amber-200',
    danger:  'border-red-900 bg-red-950 text-red-200',
} %}
{% set icon_colors = {
    info:    'text-amber-400',
    success: 'text-emerald-300',
    warning: 'text-amber-300',
    danger:  'text-red-300',
} %}
{% set variant = type in styles|keys ? type : 'info' %}
<div {{ attributes.defaults({
    class: 'flex w-fit max-w-full items-start gap-3 rounded-[10px] border px-4 py-3 ' ~ styles[variant],
    role: variant in ['danger', 'warning'] ? 'alert' : 'status',
}) }}>
    <svg class="mt-0.5 h-5 w-5 shrink-0 {{ icon_colors[variant] }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {% if variant == 'success' %}
            <circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
        {% elseif variant == 'danger' %}
            <circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16.5h.01"/>
        {% elseif variant == 'warning' %}
            <path d="M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/>
        {% else %}
            <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/>
        {% endif %}
    </svg>
    <p class="leading-relaxed">{{ message }}</p>
</div>
