{% extends "base.html.twig" %}

{% block title %}Profil de {{ name }}{% endblock %}

{% block body %}
<section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24">
    <div class="mb-12 flex flex-wrap items-end gap-8 border-b border-stone-800 pb-10">
        <div aria-hidden="true" class="grid h-20 w-20 place-items-center rounded-2xl border border-stone-700 bg-stone-900 font-['Fraunces',serif] text-4xl font-medium text-amber-400 uppercase">{{ name|first }}</div>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-400">Profil utilisateur</p>
            <h1 class="mt-5 font-['Fraunces',serif] text-5xl leading-[1.05] font-medium tracking-tight capitalize md:text-6xl">{{ name }}</h1>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-stone-800 bg-stone-900 p-8">
            <div class="grid h-12 w-12 place-items-center rounded-xl border border-stone-700 text-amber-400">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            </div>
            <h2 class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-stone-400">Nom</h2>
            <p class="mt-2 font-['Fraunces',serif] text-2xl font-medium tracking-tight capitalize">{{ name }}</p>
        </div>

        <a href="{{ path('app_books') }}" class="group flex flex-col rounded-2xl border border-stone-800 bg-stone-900 p-8 transition duration-200 hover:-translate-y-1 hover:border-stone-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">
            <div class="grid h-12 w-12 place-items-center rounded-xl border border-stone-700 text-amber-400">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
            </div>
            <h2 class="mt-6 font-['Fraunces',serif] text-2xl font-medium tracking-tight">Le catalogue</h2>
            <p class="mt-3 flex-1 leading-relaxed text-stone-400">Parcourez les livres de la bibliothèque.</p>
            <span class="mt-6 inline-flex items-center gap-1.5 font-semibold text-amber-400 group-hover:text-amber-300">
                Voir les livres
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
        </a>
    </div>
</section>
{% endblock body %}
